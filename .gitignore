monitoring/grafana/dashboards/sqlserver-to-aurora-cdc.json
monitoring/grafana/dashboards/aurora-to-sqlserver-cdc.json

# Generated remediation scripts (customer-specific, contain hostnames)
db-prep/remediation-*.sql

# Kafka audit output directories
kafka-audit*/

