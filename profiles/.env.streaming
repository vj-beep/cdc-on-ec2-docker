# =============================================================================
# .env.streaming — Tuning Profile for Steady-State CDC Streaming
#
# Optimized for low-latency, real-time change data capture.
# Prioritizes sub-second end-to-end latency over throughput.
#
# Usage:
#   ./scripts/on-demand-switch-profile.sh streaming
#
# This is the default profile for ongoing CDC operations.
# =============================================================================

# ---------------------------------------------------------------------------
# Connect Worker — Consumer Settings (reading from Kafka)
# ---------------------------------------------------------------------------

# → connect worker: consumer.override.fetch.max.bytes
# Maximum bytes per fetch — smaller to reduce buffering delay
CONNECT_CONSUMER_FETCH_MAX_BYTES=52428800

# → connect worker: consumer.override.fetch.min.bytes
# Minimum bytes before returning a fetch — low value for immediate delivery
CONNECT_CONSUMER_FETCH_MIN_BYTES=1

# → connect worker: consumer.override.fetch.max.wait.ms
# Maximum time to wait for fetch.min.bytes — return immediately when data arrives
CONNECT_CONSUMER_FETCH_MAX_WAIT_MS=10

# → connect worker: consumer.max.poll.records
# Maximum records per poll() — smaller batches for lower latency
CONNECT_CONSUMER_MAX_POLL_RECORDS=500

# → connect worker: consumer.override.max.partition.fetch.bytes
# Maximum bytes per partition per fetch — sized for change events (not bulk)
CONNECT_CONSUMER_MAX_PARTITION_FETCH_BYTES=1048576

# → connect worker: consumer.override.session.timeout.ms
# Consumer session timeout — standard value for streaming
CONNECT_CONSUMER_SESSION_TIMEOUT_MS=30000

# → connect worker: consumer.override.heartbeat.interval.ms
# Consumer heartbeat interval — standard for streaming
CONNECT_CONSUMER_HEARTBEAT_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# Connect Worker — Producer Settings (writing to Kafka)
# ---------------------------------------------------------------------------

# → connect worker: producer.override.batch.size
# Producer batch size — smaller for low-latency sends
CONNECT_PRODUCER_BATCH_SIZE=32768

# → connect worker: producer.override.linger.ms
# Linger time (ms) — near-zero for immediate sends on each change event
CONNECT_PRODUCER_LINGER_MS=5

# → connect worker: producer.override.buffer.memory
# Producer buffer memory — standard for streaming
CONNECT_PRODUCER_BUFFER_MEMORY=67108864

# → connect worker: producer.override.compression.type
# Compression — lz4 offers best latency/compression ratio for streaming
CONNECT_PRODUCER_COMPRESSION_TYPE=lz4

# → connect worker: producer.override.max.request.size
# Maximum size of a request in bytes
CONNECT_PRODUCER_MAX_REQUEST_SIZE=1048576

# ---------------------------------------------------------------------------
# Connect Worker — Offset Flush (how often sink connectors commit)
# ---------------------------------------------------------------------------

# → connect worker: offset.flush.interval.ms
# Lower = less lag between Kafka consumption and DB write commit
CONNECT_OFFSET_FLUSH_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# SQL Server CDC Agent — low latency for streaming
# ---------------------------------------------------------------------------
# → sql-server sp_cdc_enable_db: @maxtrans
CDC_CAPTURE_MAXTRANS=50
# → sql-server sp_cdc_enable_db: @maxscans
CDC_CAPTURE_MAXSCANS=100
# → sql-server sp_cdc_enable_db: @polling_interval (seconds)
CDC_CAPTURE_POLLING=0

# ---------------------------------------------------------------------------
# SQL Server Source Connector (Debezium)
# ---------------------------------------------------------------------------

# → debezium-sqlserver: snapshot.mode
SQLSERVER_SOURCE_SNAPSHOT_MODE=no_data
# → debezium-sqlserver: snapshot.fetch.size (rows per SELECT during snapshot)
SQLSERVER_SOURCE_SNAPSHOT_FETCH_SIZE=2048
# → debezium-sqlserver: max.batch.size (max rows per connector poll cycle)
SQLSERVER_SOURCE_MAX_BATCH_SIZE=256
# → debezium-sqlserver: max.queue.size (internal queue capacity in records)
SQLSERVER_SOURCE_MAX_QUEUE_SIZE=8192
# → debezium-sqlserver: max.queue.size.in.bytes (internal queue capacity in bytes)
SQLSERVER_SOURCE_MAX_QUEUE_SIZE_IN_BYTES=67108864
# → debezium-sqlserver: poll.interval.ms (ms between CDC log polls)
SQLSERVER_SOURCE_POLL_INTERVAL_MS=50

# ---------------------------------------------------------------------------
# Aurora PG Source Connector (Debezium)
# ---------------------------------------------------------------------------

# → debezium-postgres: snapshot.mode
AURORA_SOURCE_SNAPSHOT_MODE=no_data
# → debezium-postgres: snapshot.fetch.size (rows per SELECT during snapshot)
AURORA_SOURCE_SNAPSHOT_FETCH_SIZE=2048
# → debezium-postgres: max.batch.size (max rows per connector poll cycle)
AURORA_SOURCE_MAX_BATCH_SIZE=256
# → debezium-postgres: max.queue.size (internal queue capacity in records)
AURORA_SOURCE_MAX_QUEUE_SIZE=8192
# → debezium-postgres: max.queue.size.in.bytes (internal queue capacity in bytes)
AURORA_SOURCE_MAX_QUEUE_SIZE_IN_BYTES=67108864
# → debezium-postgres: poll.interval.ms (ms between WAL polls)
AURORA_SOURCE_POLL_INTERVAL_MS=50
# → debezium-postgres: heartbeat.interval.ms (keeps replication slot alive; more frequent for streaming)
AURORA_SOURCE_HEARTBEAT_INTERVAL_MS=1000

# ---------------------------------------------------------------------------
# JDBC Sink Connectors
# ---------------------------------------------------------------------------

# → jdbc-sink-aurora: batch.size (records per JDBC batch INSERT/UPSERT)
JDBC_SINK_AURORA_BATCH_SIZE=500
# → jdbc-sink-aurora: tasks.max (parallel sink tasks)
JDBC_SINK_AURORA_TASKS_MAX=3

# → jdbc-sink-sqlserver: batch.size (records per JDBC batch INSERT/UPSERT)
JDBC_SINK_SQLSERVER_BATCH_SIZE=500
# → jdbc-sink-sqlserver: tasks.max (parallel sink tasks)
JDBC_SINK_SQLSERVER_TASKS_MAX=3

# ---------------------------------------------------------------------------
# Kafka Broker Tuning (applied via environment overrides)
# ---------------------------------------------------------------------------

# → broker: replica.fetch.max.bytes
# Replica fetch size — standard for streaming
KAFKA_REPLICA_FETCH_MAX_BYTES=1048576

# → broker: message.max.bytes
# Message max bytes — standard for individual change events
KAFKA_MESSAGE_MAX_BYTES=1048576

# → broker: socket.send.buffer.bytes
KAFKA_SOCKET_SEND_BUFFER_BYTES=131072
# → broker: socket.receive.buffer.bytes
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=131072

# → broker: num.io.threads
# I/O and network threads — standard for streaming workloads
KAFKA_NUM_IO_THREADS=8

# → broker: num.network.threads
KAFKA_NUM_NETWORK_THREADS=4

# → broker: log.flush.interval.messages
# Log flush interval — more frequent flushing for durability
KAFKA_LOG_FLUSH_INTERVAL_MESSAGES=10000
