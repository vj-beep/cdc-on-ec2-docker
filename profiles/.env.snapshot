# =============================================================================
# .env.snapshot — Tuning Profile for Initial Data Load / Bulk Snapshot
#
# Optimized for high-throughput batch transfer of existing data.
# Prioritizes throughput over latency.
#
# Usage:
#   ./scripts/on-demand-switch-profile.sh snapshot
#
# Switch to .env.streaming after the initial snapshot is complete.
# =============================================================================

# ---------------------------------------------------------------------------
# Connect Worker — Consumer Settings (reading from Kafka)
# ---------------------------------------------------------------------------

# → connect worker: consumer.override.fetch.max.bytes
# Maximum bytes per fetch request — larger = fewer round-trips during snapshot
CONNECT_CONSUMER_FETCH_MAX_BYTES=104857600

# → connect worker: consumer.override.fetch.min.bytes
# Minimum bytes to accumulate before returning a fetch — reduces fetch frequency
CONNECT_CONSUMER_FETCH_MIN_BYTES=1048576

# → connect worker: consumer.override.fetch.max.wait.ms
# Maximum time to wait for fetch.min.bytes to be satisfied (ms)
CONNECT_CONSUMER_FETCH_MAX_WAIT_MS=500

# → connect worker: consumer.max.poll.records
# Maximum records per poll() call — higher = larger batches for sink connectors
CONNECT_CONSUMER_MAX_POLL_RECORDS=10000

# → connect worker: consumer.override.max.partition.fetch.bytes
# Maximum bytes per partition per fetch — sized for large snapshot batches
CONNECT_CONSUMER_MAX_PARTITION_FETCH_BYTES=10485760

# → connect worker: consumer.override.session.timeout.ms
# Consumer session timeout — longer timeout to avoid rebalances during heavy load
CONNECT_CONSUMER_SESSION_TIMEOUT_MS=60000

# → connect worker: consumer.override.heartbeat.interval.ms
# Consumer heartbeat interval — must be less than session.timeout.ms
CONNECT_CONSUMER_HEARTBEAT_INTERVAL_MS=20000

# → connect worker: consumer.override.max.poll.interval.ms
# Max time between poll() calls before broker considers consumer dead and triggers rebalance.
# Increase for snapshot loads where sink writes to Aurora/SQL Server are slow (> default 5 min).
CONNECT_CONSUMER_MAX_POLL_INTERVAL_MS=600000

# ---------------------------------------------------------------------------
# Connect Worker — Producer Settings (writing to Kafka)
# ---------------------------------------------------------------------------

# → connect worker: producer.override.batch.size
# Producer batch size in bytes — larger batches for throughput
CONNECT_PRODUCER_BATCH_SIZE=1048576

# → connect worker: producer.override.linger.ms
# Time to wait for more records before sending a batch (ms)
# Higher linger = fuller batches = better throughput (at cost of latency)
CONNECT_PRODUCER_LINGER_MS=100

# → connect worker: producer.override.buffer.memory
# Producer buffer memory — total bytes available for buffering
CONNECT_PRODUCER_BUFFER_MEMORY=134217728

# → connect worker: producer.override.compression.type
# zstd beats snappy on compression ratio for bulk data (fewer bytes over broker wire)
# at comparable CPU cost on modern EC2 instances.
CONNECT_PRODUCER_COMPRESSION_TYPE=zstd

# → connect worker: producer.override.max.request.size
# Maximum size of a request in bytes
CONNECT_PRODUCER_MAX_REQUEST_SIZE=10485760

# ---------------------------------------------------------------------------
# Connect Worker — Offset Flush (less frequent for throughput)
# ---------------------------------------------------------------------------

# → connect worker: offset.flush.interval.ms
CONNECT_OFFSET_FLUSH_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# SQL Server CDC Agent — high throughput for bulk snapshot
# ---------------------------------------------------------------------------
# → sql-server sp_cdc_enable_db: @maxtrans
CDC_CAPTURE_MAXTRANS=10000
# → sql-server sp_cdc_enable_db: @maxscans
CDC_CAPTURE_MAXSCANS=100
# → sql-server sp_cdc_enable_db: @polling_interval (seconds)
CDC_CAPTURE_POLLING=0

# ---------------------------------------------------------------------------
# SQL Server Source Connector (Debezium)
# ---------------------------------------------------------------------------

# → debezium-sqlserver: snapshot.mode
SQLSERVER_SOURCE_SNAPSHOT_MODE=initial
# → debezium-sqlserver: snapshot.fetch.size (rows per SELECT during snapshot)
SQLSERVER_SOURCE_SNAPSHOT_FETCH_SIZE=20000
# → debezium-sqlserver: max.batch.size (max rows per connector poll cycle)
SQLSERVER_SOURCE_MAX_BATCH_SIZE=16384
# → debezium-sqlserver: max.queue.size (internal queue capacity in records)
SQLSERVER_SOURCE_MAX_QUEUE_SIZE=65536
# → debezium-sqlserver: max.queue.size.in.bytes (internal queue capacity in bytes)
SQLSERVER_SOURCE_MAX_QUEUE_SIZE_IN_BYTES=134217728
# → debezium-sqlserver: poll.interval.ms (ms between CDC log polls)
SQLSERVER_SOURCE_POLL_INTERVAL_MS=100

# ---------------------------------------------------------------------------
# Aurora PG Source Connector (Debezium)
# ---------------------------------------------------------------------------

# → debezium-postgres: snapshot.mode
AURORA_SOURCE_SNAPSHOT_MODE=initial
# → debezium-postgres: snapshot.fetch.size (rows per SELECT during snapshot)
AURORA_SOURCE_SNAPSHOT_FETCH_SIZE=20000
# → debezium-postgres: max.batch.size (max rows per connector poll cycle)
AURORA_SOURCE_MAX_BATCH_SIZE=16384
# → debezium-postgres: max.queue.size (internal queue capacity in records)
AURORA_SOURCE_MAX_QUEUE_SIZE=65536
# → debezium-postgres: max.queue.size.in.bytes (internal queue capacity in bytes)
AURORA_SOURCE_MAX_QUEUE_SIZE_IN_BYTES=134217728
# → debezium-postgres: poll.interval.ms (ms between WAL polls)
AURORA_SOURCE_POLL_INTERVAL_MS=100
# → debezium-postgres: heartbeat.interval.ms (keeps replication slot alive during low traffic)
AURORA_SOURCE_HEARTBEAT_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# JDBC Sink Connectors
# ---------------------------------------------------------------------------

# → jdbc-sink-aurora: batch.size (records per JDBC batch INSERT/UPSERT)
JDBC_SINK_AURORA_BATCH_SIZE=10000
# → jdbc-sink-aurora: tasks.max — match topic partition count for full parallelism
JDBC_SINK_AURORA_TASKS_MAX=3

# → jdbc-sink-sqlserver: batch.size (records per JDBC batch INSERT/UPSERT)
JDBC_SINK_SQLSERVER_BATCH_SIZE=10000
# → jdbc-sink-sqlserver: tasks.max — match topic partition count for full parallelism
JDBC_SINK_SQLSERVER_TASKS_MAX=3

# ---------------------------------------------------------------------------
# Kafka Broker Tuning (applied via environment overrides)
# ---------------------------------------------------------------------------

# → broker: replica.fetch.max.bytes
# Replica fetch size — larger for faster replication during high-throughput
KAFKA_REPLICA_FETCH_MAX_BYTES=10485760

# → broker: message.max.bytes
# +120 bytes over max request size to prevent "Message Too Large" errors at broker boundary
KAFKA_MESSAGE_MAX_BYTES=10485880

# → broker: socket.send.buffer.bytes
KAFKA_SOCKET_SEND_BUFFER_BYTES=1048576
# → broker: socket.receive.buffer.bytes
KAFKA_SOCKET_RECEIVE_BUFFER_BYTES=1048576

# → broker: num.io.threads
# Number of I/O threads — increase for snapshot load
KAFKA_NUM_IO_THREADS=16

# → broker: num.network.threads
KAFKA_NUM_NETWORK_THREADS=8

# → broker: log.flush.interval.messages
# Log flush interval — less frequent flushing for throughput
KAFKA_LOG_FLUSH_INTERVAL_MESSAGES=50000
