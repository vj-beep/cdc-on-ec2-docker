{
  "name": "jdbc-sink-sqlserver",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "${JDBC_SINK_SQLSERVER_TASKS_MAX}",
    "batch.size": "${JDBC_SINK_SQLSERVER_BATCH_SIZE}",

    "connection.url": "jdbc:sqlserver://${SQLSERVER_HOST}:${SQLSERVER_PORT};databaseName=${SQLSERVER_DATABASE};encrypt=false",
    "connection.user": "${SQLSERVER_USER}",
    "connection.password": "${SQLSERVER_PASSWORD}",

    "topics.regex": "${JDBC_SINK_SQLSERVER_TOPICS_REGEX}",

    "insert.mode": "upsert",
    "pk.mode": "record_key",
    "auto.create": "false",
    "auto.evolve": "false",
    "quote.identifiers": "true",
    "delete.enabled": "true",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "true",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "true",

    "transforms": "convertTs,convertTs2,stripNullBytes,routeTopics,caseRestorer",

    "transforms.convertTs.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertTs.target.type": "Timestamp",
    "transforms.convertTs.field": "createdat",
    "transforms.convertTs.unix.precision": "milliseconds",

    "transforms.convertTs2.type": "org.apache.kafka.connect.transforms.TimestampConverter$Value",
    "transforms.convertTs2.target.type": "Timestamp",
    "transforms.convertTs2.field": "updatedat",
    "transforms.convertTs2.unix.precision": "milliseconds",

    "transforms.stripNullBytes.type": "com.example.kafka.connect.transforms.StripNullBytes",

    "transforms.routeTopics.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.routeTopics.regex": "${JDBC_SINK_SQLSERVER_TOPIC_REGEX}",
    "transforms.routeTopics.replacement": "$1",

    "transforms.caseRestorer.type": "com.example.kafka.connect.transforms.SqlServerCaseRestorer",
    "transforms.caseRestorer.jdbc.url": "jdbc:sqlserver://${SQLSERVER_HOST}:${SQLSERVER_PORT};databaseName=${SQLSERVER_DATABASE};encrypt=false",
    "transforms.caseRestorer.jdbc.user": "${SQLSERVER_USER}",
    "transforms.caseRestorer.jdbc.password": "${SQLSERVER_PASSWORD}",
    "transforms.caseRestorer.table.schema": "dbo",

    "consumer.override.fetch.max.wait.ms": "10",
    "consumer.override.fetch.min.bytes": "1",
    "consumer.override.metadata.max.age.ms": "30000",

    "errors.tolerance": "all",
    "errors.deadletterqueue.topic.name": "dlq-jdbc-sink-sqlserver",
    "errors.deadletterqueue.topic.replication.factor": "${KAFKA_REPLICATION_FACTOR}",
    "errors.deadletterqueue.context.headers.enable": "true",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}
